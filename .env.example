# Copy to .env and fill in the platforms you want to use.
# A platform with missing values is reported as "failed: Not configured" and the others still post.

# --- General ---------------------------------------------------------------
# Platforms to post to, in order (bluesky, mastodon, telegram, discord, devto, github_gist)
ENABLED_PLATFORMS=bluesky,mastodon,telegram,discord,devto,github_gist
REQUEST_TIMEOUT_SECONDS=15
# Time zone for the date/time in the response
TIMEZONE=Asia/Kolkata
# Open each posted URL anonymously to confirm it is publicly accessible
VERIFY_PUBLIC_ACCESS=true

# --- Bluesky: Settings -> Privacy and security -> App passwords -------------
BLUESKY_SERVICE=https://bsky.social
BLUESKY_HANDLE=
BLUESKY_APP_PASSWORD=

# --- Mastodon: Preferences -> Development -> New application (scope write:statuses)
MASTODON_INSTANCE_URL=https://mastodon.social
MASTODON_ACCESS_TOKEN=

# --- Telegram: create a bot with @BotFather, add it as admin of a PUBLIC channel
TELEGRAM_BOT_TOKEN=
# Public channel username, e.g. @my_channel
TELEGRAM_CHANNEL=

# --- Discord: Server settings -> Integrations -> Webhooks -> New webhook ---
DISCORD_WEBHOOK_URL=
# Optional: server (guild) id, used to build a link to the posted message
DISCORD_GUILD_ID=

# --- DEV Community: https://dev.to/settings/extensions -> DEV Community API Keys
DEVTO_API_KEY=
DEVTO_TAGS=business,marketing

# --- GitHub Gist: fine-grained or classic token with the "gist" scope -----
GIST_TOKEN=
